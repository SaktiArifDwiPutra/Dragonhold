DATABASE_URL=postgres://dragonhold:dragonhold@localhost:5432/dragonhold

# Hanya dipakai oleh seed untuk membuat SUPER_ADMIN pertama
SEED_ADMIN_USERNAME=creator
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ganti-dengan-password-kuat

API_PORT=4000
WEB_ORIGIN=http://localhost:3000

# Google OAuth 2.0 / OpenID Connect (server-side only; never expose GOOGLE_CLIENT_SECRET)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Domain cookie untuk custom domain lintas subdomain (misal: .dragonhold.my.id)
# Kosongkan saat lokal
COOKIE_DOMAIN=

TRUSTED_PROXY_HOPS=0